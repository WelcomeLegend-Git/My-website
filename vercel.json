{
  "version": 2,
  "buildCommand": "cd apps/web && npm run build",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://jee-server.vercel.app/api/:path*"
    },
    {
      "source": "/trpc/:path*",
      "destination": "https://jee-server.vercel.app/trpc/:path*"
    }
  ]
}
