generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FormulaDifficulty {
  easy
  medium
  hard
}

enum FormulaAssetKind {
  image
  pdf
  link
}

enum MistakeDifficulty {
  easy
  medium
  hard
}

enum MistakeStatus {
  new
  reviewing
  resolved
}

enum MistakeErrorType {
  conceptual
  calculation
  careless
  unknown
}

enum MistakeAssetKind {
  image
  pdf
  question
  solution
  working
  note
  link
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  name         String
  passwordHash String
  subjects     Subject[]
  formulas     Formula[]
  mistakes     Mistake[]
  quizSessions QuizSession[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Subject {
  id          String    @id @default(uuid())
  name        String
  description String?
  ownerId     String
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  chapters    Chapter[]
  formulas    Formula[]
  mistakes    Mistake[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([ownerId, name])
}

model Chapter {
  id        String    @id @default(uuid())
  title     String
  description String?
  subjectId String
  subject   Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  formulas  Formula[]
  mistakes  Mistake[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([subjectId, title])
}

model Formula {
  id              String            @id @default(uuid())
  title           String
  expression      String
  explanation     String?
  derivationSteps Json
  tags            Json
  difficulty      FormulaDifficulty @default(medium)
  mindMap         Json?
  ownerId         String
  owner           User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  subjectId       String
  subject         Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  chapterId       String
  chapter         Chapter           @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  assets          FormulaAsset[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([ownerId])
  @@index([subjectId])
  @@index([chapterId])
}

model FormulaAsset {
  id        String           @id @default(uuid())
  formulaId String
  formula   Formula          @relation(fields: [formulaId], references: [id], onDelete: Cascade)
  kind      FormulaAssetKind
  url       String
  title     String?
  createdAt DateTime         @default(now())
}

model Mistake {
  id         String            @id @default(uuid())
  title      String
  description String
  difficulty MistakeDifficulty @default(medium)
  status     MistakeStatus     @default(new)
  errorType  MistakeErrorType  @default(unknown)
  aiSummary  String?
  aiMindMap  Json?
  ownerId    String
  owner      User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  subjectId  String
  subject    Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  chapterId  String
  chapter    Chapter           @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  assets     MistakeAsset[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([ownerId])
  @@index([subjectId])
  @@index([chapterId])
}

model MistakeAsset {
  id         String           @id @default(uuid())
  mistakeId  String
  mistake    Mistake          @relation(fields: [mistakeId], references: [id], onDelete: Cascade)
  kind       MistakeAssetKind
  url        String
  caption    String?
  createdAt  DateTime         @default(now())
}

enum QuizType {
  formula_based
  mistake_review
  mixed
}

model QuizSession {
  id          String      @id @default(uuid())
  title       String
  type        QuizType
  subjectId   String?
  chapterId   String?
  totalQuestions Int
  correctAnswers Int       @default(0)
  completedAt DateTime?
  ownerId     String
  owner       User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  questions   QuizQuestion[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([ownerId])
}

model QuizQuestion {
  id              String       @id @default(uuid())
  sessionId       String
  session         QuizSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionText    String
  options         Json         // Array of options
  correctAnswer   Int          // Index of correct option
  explanation     String?
  userAnswer      Int?         // User's selected answer index
  isCorrect       Boolean?
  formulaId       String?      // Reference to formula if generated from formula
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([sessionId])
}