{
  "name": "jee-study-companion",
  "private": true,
  "version": "0.0.1",
  "packageManager": "npm@11.6.1",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ]
  },
  "scripts": {
    "preinstall": "npm install -g patch-package || true",
    "postinstall": "prisma generate --schema apps/server/prisma/schema.prisma",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build",
    "dev": "turbo run dev"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "eslint": "9.39.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "globals": "16.5.0",
    "prisma": "^5.21.0",
    "turbo": "^2.2.4",
    "typescript-eslint": "8.46.3"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.80.0",
    "patch-package": "8.0.1"
  }
}
