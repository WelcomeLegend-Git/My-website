    "@types/multer": "^1.4.12",
    "@types/node": "^20.14.10",
    "@types/nodemailer": "7.0.4",
    "@types/supertest": "^2.0.16",
    "@types/web-push": "3.6.4",
    "@vercel/node": "^3.0.0",
    "supertest": "^6.3.4",
    "ts-node-dev": "^2.0.0",
